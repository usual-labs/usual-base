// Copy to Config/Local.xcconfig (gitignored) to sign a build with your own team.
// Without this file, builds are signed to run on this Mac only.

// Your Apple Developer team ID (Xcode › Settings › Accounts).
DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_IDENTITY = Apple Development

// A reverse-DNS prefix you own, so your build doesn't clash with other forks.
BUNDLE_ID_PREFIX = com.example
