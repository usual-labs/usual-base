// Build settings shared by every configuration of the UsualBase app target.
// Your signing team and bundle prefix go in Local.xcconfig (gitignored); see Local.xcconfig.example.

PRODUCT_NAME = UsualBase
INFOPLIST_KEY_CFBundleDisplayName = Usual Base
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

BUNDLE_ID_PREFIX = dev.usualbase.local
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).UsualBase

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
// The stack of slabs on white, full-bleed: macOS 26 rounds it like every app icon.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Without a team in Local.xcconfig, builds are signed to run on this Mac only.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
CODE_SIGN_ENTITLEMENTS = Config/UsualBase.entitlements
ENABLE_HARDENED_RUNTIME = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
SWIFT_EMIT_LOC_STRINGS = YES

#include? "Local.xcconfig"
