#!/bin/sh
# The plugin's entry point: finds the installed usual-base CLI and runs it for this project.
# `hook` reads Claude Code's hook JSON on stdin; `watch` prints one line per new room message.
# In a project that isn't set up (`usual-base setup claude-code <folder>`), both stay silent.
PATH="$HOME/.local/bin:$PATH"
command -v usual-base >/dev/null 2>&1 || exit 0
case "$1" in
  hook) exec usual-base hook claude-code ;;
  watch) exec usual-base hook claude-code watch ;;
esac
